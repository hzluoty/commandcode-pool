# 部署与安全配置
ADMIN_TOKEN=your_admin_password_here
API_KEYS=sk-client-key-1,sk-client-key-2

# 号池账号初始化（可选，免数据库快速部署）
# 支持 JSON 数组格式：[{"key":"user_xxx","label":"go-1"},{"key":"user_yyy","label":"go-2"}]
# 或逗号隔开的 Key 列表：user_xxx,user_yyy
ACCOUNTS=

# 号池调度策略：sticky（默认，保持会话命中Prompt Cache降低封号风险） 或 round_robin
POOL_STRATEGY=sticky

# 时区偏移（小时，默认 8 代表 UTC+8）
TIMEZONE_OFFSET=8

# Vercel KV / Upstash Redis 持久化（可选，在 Vercel 绑定 KV 存储时自动填入）
KV_REST_API_URL=
KV_REST_API_TOKEN=

# 自定义 Command Code 上游（默认为 https://api.commandcode.ai）
CC_API_BASE=https://api.commandcode.ai
CMD_ZDR=0
